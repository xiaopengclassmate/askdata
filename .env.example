# 复制成 .env 后填写真实值（.env 已在 .gitignore 中）
# 复用你 Java 项目里的 DashScope key 即可，不需要另外开通
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 数据源：留空用本地 SQLite（demo 默认）；填上就切到 PostgreSQL，
# 提示词里的方言、行级权限的实现会跟着换。需要先装 requirements-postgres.txt
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/askdata
DB_TIMEZONE=UTC

# 查询沙箱限制
QUERY_MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=5
# 裸 SQL 执行口 /api/query：本地调试用，线上设 false
ENABLE_RAW_SQL=true

# ---- 公网保护（0 = 关闭该项；本地开发可以全填 0）----
# 单 IP 每 60 秒：ask 会真花额度，卡紧一点；query 只跑本地 SQL
ASK_RATE_PER_MIN=10
QUERY_RATE_PER_MIN=30
# 全局每天最多多少次 ask（一次 ask 最多触发 3 次模型调用），把最坏损失锁死
DAILY_ASK_QUOTA=200
# 同时处理的 ask 请求数
MAX_CONCURRENT_ASK=4
# 前面挂了可信代理（Nginx / SLB）才设 true；直连时开了等于允许伪造 IP 绕过限流
TRUST_PROXY_HEADERS=false

LOG_LEVEL=INFO
